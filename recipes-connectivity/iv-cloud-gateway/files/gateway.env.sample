# iv-cloud-gateway configuration -- installed to /etc/vehicle-gateway/.env
# (CONFFILE, editable on-device without rebuilding). Loaded at startup by
# gateway::Config::from_env(); real environment variables (e.g. the systemd
# unit's own Environment=/EnvironmentFile=) take precedence over this file.

# -- Backend (HTTP auth API) --------------------------------------------------
BASE_URL=REPLACE_WITH_BACKEND_URL

# -- Admin bootstrap (fleet admin signup / verify / login) --------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_PHONE=+1234567890
VERIFY_CODE=111111

# -- Vehicle identity + registration ------------------------------------------
VIN_NUMBER=REPLACE_WITH_VIN
PLATE_NO=ABC-1234
COLOR=white
CAR_COMPANY=Toyota
MODEL=Prius
SEAT_NO=4
START_LAT=35.68677918
START_LON=139.69154336

# -- MQTT broker ----------------------------------------------------------------
MQTT_BROKER=REPLACE_WITH_MQTT_BROKER_HOST
MQTT_PORT=1883
MQTT_CLIENT_ID=vehicle_gateway

# -- gRPC (server listen address) ----------------------------------------------
GRPC_LISTEN=0.0.0.0:50051

# -- Zenoh subscriber connect endpoint (autoware-agent) ------------------------
ZENOH_CONNECT=udp/127.0.0.1:7447

# -- Autoware cluster gRPC (optional) ------------------------------------------
AUTOWARE_GRPC_ADDR=127.0.0.1:50051
