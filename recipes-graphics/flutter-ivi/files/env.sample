# flutter_ivi build-time configuration -- bundled as a Flutter asset (assets: .env)
# and read via flutter_dotenv (dotenv.load('.env')) at app startup.
#
# IMPORTANT: this is BAKED INTO THE APP BUNDLE at `flutter build` time, so it must
# hold the TARGET values (and any secrets) when the flutter-ivi recipe builds.
# flutter-ivi.bb copies files/env.real over this at do_configure if present (never
# committed -- see .gitignore); otherwise it falls back to this placeholder file
# and prints a build warning.

# -- Navigation ------------------------------------------------------------
# Google Maps Platform (Directions API + Maps JavaScript API)
GOOGLE_MAPS_API_KEY=REPLACE_WITH_TARGET_MAPS_KEY
# Initial map center -- must match the vehicle's simulated/real starting pose
# (same lat/lon as iv-cloud-gateway's START_LAT/START_LON) so the in-app map
# opens already centered on the vehicle instead of the app's hardcoded default.
INITIAL_LAT=REPLACE_WITH_INITIAL_LAT
INITIAL_LON=REPLACE_WITH_INITIAL_LON

# -- Fleet gateway (iv-cloud-gateway gRPC) ----------------------------------
GATEWAY_HOST=REPLACE_WITH_GATEWAY_HOST
GATEWAY_PORT=50051

# -- Autoware cluster gRPC ---------------------------------------------------
CLUSTER_HOST=REPLACE_WITH_CLUSTER_HOST
CLUSTER_PORT=50052

# -- Zenoh vehicle UDP endpoint (autoware-agent) -----------------------------
ZENOH_VEHICLE_IP=REPLACE_WITH_VEHICLE_IP

# -- Vehicle identification number sent to the fleet backend -----------------
VIN_NUMBER=REPLACE_WITH_VIN

# -- Fleet backend REST API (trip confirmation, etc.) -------------------------
BASE_URL=REPLACE_WITH_BASE_URL

# -- Spotify ------------------------------------------------------------------
SPOTIFY_CLIENT_ID=REPLACE_WITH_SPOTIFY_CLIENT_ID
# Cloudflare Worker relay URL (leave empty to fall back to local HTTPS).
SPOTIFY_RELAY_URL=
# Audio backend for spotifyd: 'alsa' on most embedded targets, 'pulseaudio' on VMs.
SPOTIFYD_BACKEND=alsa
# Canvas (looping album video) needs spotifyd stored creds; off in the multi-user
# zeroconf model. Leave false.
ENABLE_CANVAS_VIDEO=false
