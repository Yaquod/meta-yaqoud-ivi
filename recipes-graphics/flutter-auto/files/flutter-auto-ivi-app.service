[Unit]
Description=Flutter Auto IVI Application
After=agl-compositor.service systemd-time-wait-sync.service
Wants=systemd-time-wait-sync.service
Requires=agl-compositor.service

[Service]
User=agl-driver
Group=agl-driver
WorkingDirectory=/home/agl-driver
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=WAYLAND_DISPLAY=wayland-0
# CEF/FFI webview backend (chromium_dart_view plugin dlopen()s this by soname
# on the default lib path too; pinned explicitly here per upstream flutter-ivi
# guidance -- see recipes-graphics/flutter-ivi/flutter-ivi.bb).
Environment=CHROMIUM_DART_LIB=/usr/lib/libchromium_nc.so
# libchromium_nc.so bakes a build-host sysroot path as its CEF_ROOT fallback
# (see recipes-graphics/chromium-dart/libchromium-nc_git.bb) -- it reads this
# env var first, so this is required, not optional, for CEF to find
# Resources/Release on the actual device.
Environment=CEF_ROOT=/usr/share/cef
Environment=VIDEO_PLAYER_AUDIO_SINK=autoaudiosink
EnvironmentFile=-/etc/default/flutter-ivi
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/flutter-auto \
    -b /usr/share/flutter/yaqoud-flutter-ivi/3.38.3/release/ \
    --width=1024 --height=600 \
    --window-type=BG \
    --output-index=0
Restart=on-failure
RestartSec=3
# Confirmed on-device: this process's Chromium/CEF webview can balloon to
# ~4GB RSS under active use, and with no swap configured that alone was
# enough to trigger a kernel OOM kill. Positive OOMScoreAdjust makes this the
# preferred OOM victim over the Autoware/agent containers (oom_score_adj=-900
# there) -- losing the IVI app is a UX problem; losing a driving-critical
# container mid-drive is a safety problem.
OOMScoreAdjust=800

[Install]
WantedBy=graphical.target
